generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int        @id @default(autoincrement())
  clerkId     String     @unique 
  full_name   String?
  username    String?    @unique 
  email       String     @unique
  user_status UserStatus @default(STANDARD)
  created_at  DateTime   @default(now())
  last_login  DateTime   @default(now())
  currency    Float      @default(0)
  
  // Relations
  userCards        UserCards[]
  userAchievements UserAchievement[]
  userInventory    UserInventory[]
  userStats        UserStats?  // One-to-one relation
}

enum UserStatus {
  STANDARD
  SPECIAL
  CREATOR
}

model UserStats {
  id                  Int      @id @default(autoincrement())
  user_id             Int      @unique
  total_pulls         Int      @default(0)
  unique_cards        Int      @default(0)
  wins                Int      @default(0)
  losses              Int      @default(0)
  trades_completed    Int      @default(0)
  purchases_made      Int      @default(0)
  login_streak        Int      @default(0)
  last_login_date     DateTime?
  total_play_minutes  Int      @default(0)
  total_cards_sold    Int      @default(0)
  consecutive_wins    Int      @default(0)
  highest_win_streak  Int      @default(0)
  consecutive_losses  Int      @default(0)
  highest_lose_streak Int      @default(0)
  battle_rating       Float    @default(1000)
  updated_at          DateTime @updatedAt

  total_currency_spent      Float @default(0)  // CURRENCY_SPENT
  total_currency_gained     Float @default(0)  // CURRENCY_GAINED
  total_cards_enhanced      Int   @default(0)  // ENHANCED_CARDS
  highest_battle_rating     Float @default(1000) // BATTLE_RATING
  tournament_wins           Int   @default(0)  // TOURNAMENT_WINS
  lucky_pulls               Int   @default(0)  // LUCKY_PULL (legendary from common pack)
  one_shots                 Int   @default(0)  // ONE_SHOT (won battle on first turn)
  trade_flips               Int   @default(0)  // TRADE_FLIP (traded common for rare)
  login_count Int @default(0)
  
  user User @relation(fields: [user_id], references: [id])
}

model UserCards {
  id               Int         @id @default(autoincrement())
  user_id          Int
  card_template_id Int
  quality          Quality     @default(REGULAR)
  enhancement      Enhancement @default(BASIC)
  acquired_at      DateTime    @default(now())
  is_favourited    Boolean     @default(false)
  kills            Int         @default(0)
  deaths           Int         @default(0)
  sold_amount      Int?        @default(0)
  
  user         User          @relation(fields: [user_id], references: [id])
  cardTemplate CardTemplates @relation(fields: [card_template_id], references: [id])
}

enum Quality {
  TARNISHED
  POOR
  REGULAR
  GOOD
  CRISP
}

enum Enhancement {
  BASIC
  FOILED
  SHINY
  SIGNED
}

model CardTemplates {
  id        Int     @id @default(autoincrement())
  name      String?
  series    String?
  type      String?
  base_hp   Int
  base_def  Int
  base_atk  Int
  base_price Float
  rarity    String?
  image_url String?
  
  userCards UserCards[]
}

model Pack {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Float
  image_url   String?
  cards_count Int     @default(5)
  
  common_rate       Float   @default(53.7)
  uncommon_rate     Float   @default(22.6)
  sparse_rate       Float   @default(12.4)
  rare_rate         Float   @default(7.4)
  uber_rare_rate    Float   @default(2.3)
  mythical_rate     Float   @default(1.2)
  legendary_rate    Float   @default(0.4)
  special_rate      Float   @default(0)
  
  included_series     Json?
  excluded_series     Json?
  included_types      Json?
  guaranteed_card_ids Json?
  guaranteed_count    Int     @default(0)
  
  is_available    Boolean @default(true)
  available_from  DateTime?
  available_until DateTime?
  created_at      DateTime @default(now())

  shopItems ShopItem[]
}

model Item {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  item_type    ItemType
  price        Float
  image_url    String?
  is_available Boolean @default(true)
  created_at   DateTime @default(now())
  can_sell     Boolean  @default(true)

  shopItems ShopItem[]
}

enum ItemType {
  COSMETIC
}

model Achievement {
  id            Int     @id @default(autoincrement())
  name          String
  description   String
  image_url     String
  condition     Condition
  comparator    Comparator
  data_type     DataType
  value_int     Int?
  value_float   Float?
  value_string  String?
  value_bool    Boolean?
  value_date    DateTime?
  reward_type   Reward
  reward_value  String
  created_at    DateTime @default(now())
  
  userAchievements UserAchievement[]
}

enum Comparator {
  MORE_THAN
  EQUAL
  LESS_THAN
}

enum Condition {
  CURRENCY               // Compares how much you own
  CURRENCY_SPENT         // How much you spent
  CURRENCY_GAINED        // How much you gained
  LOSSES                 // How many times you lost
  WINS                   // How many times you won
  CARDS_COLLECTED        // How many cards in collection
  PACKS_OPENED           // How many opened packs
  CARD_STRENGTH          // Checks if has card of x strength
  CARD_DEFENCE           // Checks if has card of x defence
  CARD_HEALTH            // Checks if has card of x health
  CARD_RARITY            // Checks if has card is x rarity
  CARD_NAME_LENGTH       // Checks if has card is x long
  CARD_NAME_WORDS        // Checks if has card has x words
  STATUS                 // Checks user status
  ACCOUNT_AGE            // Checks account age
  LOGIN_STREAK           // Consecutive days logged in
  TOTAL_LOGINS           // Total times logged in
  TRADES_COMPLETED       // Number of successful trades
  ENHANCED_CARDS         // How many special cards owned
  CONSECUTIVE_WINS       // Win streak in battles
  CARDS_SOLD             // Total cards sold to shop
  PURCHASES_MADE         // Total shop purchases
  UNIQUE_CARD_SERIES     // Different series collected
  CARD_SET_COMPLETION    // Complete a specific card set
  BATTLE_RATING          // ELO/rank score
  TOURNAMENT_WINS        // Special event wins
  ACHIEVEMENT_COUNT      // Total achievements earned
  INVENTORY_ITEMS        // Items owned at once (packs/cosmetics)
  RARITY_COLLECTION      // Collect all cards of a rarity
  BATTLE_PARTICIPATION   // Total battles entered
  KILLS_IN_BATTLES       // Combined kill count
  PLAY_TIME              // Total minutes played
  SERIES_COMPLETED       // Completed all cards from one series amounts
  LUCKY_PULL             // Pull legendary from common pack
  ONE_SHOT               // Win a battle on first turn
  TRADE_FLIP             // Trade common for x
}

enum DataType {
  STRING
  INT
  FLOAT
  BOOLEAN
  DATE
}

enum Reward {
  NONE
  CARD
  PACK
  COSMETIC
  CURRENCY
  STATUS
}

model UserAchievement {
  id             Int      @id @default(autoincrement())
  user_id        Int
  achievement_id Int
  progress       Int      @default(0)
  completed_at   DateTime?
  claimed_at     DateTime?
  
  user        User        @relation(fields: [user_id], references: [id])
  achievement Achievement @relation(fields: [achievement_id], references: [id])
  
  @@unique([user_id, achievement_id])
}

model UserInventory {
  id           Int      @id @default(autoincrement())
  user_id      Int
  item_type    InventoryType
  reference_id Int
  quantity     Int      @default(1)
  expires_at   DateTime?
  acquired_at  DateTime @default(now())
  
  user User @relation(fields: [user_id], references: [id])
}

enum InventoryType {
  PACK
  ITEM
}

model ShopItem {
  id           Int      @id @default(autoincrement())
  item_type    ShopItemType
  pack_id      Int?
  item_id      Int?
  price        Float
  is_available Boolean @default(true)
  
  @@unique([item_type, pack_id])
  @@unique([item_type, item_id])
  
  pack Pack? @relation(fields: [pack_id], references: [id], onDelete: Cascade)
  item Item? @relation(fields: [item_id], references: [id], onDelete: Cascade)
}

enum ShopItemType {
  PACK
  ITEM
}