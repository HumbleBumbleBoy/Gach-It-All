generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int        @id @default(autoincrement())
  clerkId          String     @unique 
  full_name        String?
  username         String?    @unique 
  email            String     @unique
  user_status      UserStatus @default(STANDARD)
  created_at       DateTime   @default(now())
  last_login       DateTime   @default(now())
  total_pulls      Int        @default(0)
  unique_cards     Int        @default(0)
  wins             Int        @default(0)
  losses           Int        @default(0)
  trades_completed Int        @default(0)
  purchases_made   Int        @default(0)
  currency         Float      @default(0)
  
  userCards UserCards[]
  userAchievements UserAchievement[]
  userInventory    UserInventory[] 
}

enum UserStatus {
  STANDARD
  SPECIAL
  CREATOR  // Optional: special role for you as the game creator
}

model UserCards {
  id               Int      @id @default(autoincrement())
  user_id          Int
  card_template_id Int
  quality          String
  enhancement      String
  acquired_at      DateTime @default(now())
  is_favourited    Boolean  @default(false)
  kills            Int      @default(0)
  deaths           Int      @default(0)
  sold_amount      Int?     @default(0)
  
  user         User          @relation(fields: [user_id], references: [id])
  cardTemplate CardTemplates @relation(fields: [card_template_id], references: [id])
}

model CardTemplates {
  id        Int     @id @default(autoincrement())
  name      String?
  series    String?
  type      String?
  base_hp   Int
  base_def  Int
  base_atk  Int
  base_price Float
  rarity    String?
  image_url String?
  
  userCards UserCards[]
}

model Pack {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Float
  image_url   String?
  cards_count Int     @default(5)
  
  // Drop rates (0-100) has to add app to 100% (duh)
  common_rate       Float   @default(53.7)  // 53.7% chance by default
  uncommon_rate     Float   @default(22.6)  // 22.6% chance by default
  sparse_rate       Float   @default(12.4)   // 12.4% chance by default
  rare_rate         Float   @default(7.4)   // 7.4% chance by default
  uber_rare_rate    Float   @default(2.3)  // 2.3% chance by default
  mythical_rate     Float   @default(1.2)  // 1.2% chance by default
  legendary_rate    Float   @default(0.4)   // 0.4% chance by default
  special_rate      Float   @default(0)   // 0% chance keep for special event packs
  
  // Series filtering (which card series can appear)
  included_series Json? // JSON array: ["ikea_set", "website_set"] or "all"
  excluded_series Json? // JSON array: ["Holiday Special"]
  
  // Card type filtering
  included_types Json?  // JSON array: ["flesh", "digital", "tough"] or "all"
  
  // Special cards (fixed drops, e.g., guaranteed legendary)
  guaranteed_card_ids Json? // JSON array: [1, 42, 99]
  guaranteed_count    Int     @default(0)
  
  is_available Boolean @default(true)
  available_from DateTime?
  available_until DateTime?
  created_at  DateTime @default(now())
}

model Item {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  item_type   ItemType
  price       Float
  image_url   String?
  is_available Boolean @default(true)
  created_at  DateTime @default(now())
}

enum ItemType {
  COSMETIC
}

model Achievement {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  image_url   String
  reward_type Reward   // "pack", "currency", "card", "item" and so on
  reward_value String // If CARD: card_id, if PACK: pack_id, if CURRENCY: amount, if COSMETIC: item_id, if STATUS: string
  created_at  DateTime @default(now())
  
  userAchievements UserAchievement[]
}

enum Reward {
  CARD
  PACK
  COSMETIC
  CURRENCY
  STATUS
}

model UserAchievement {
  id             Int      @id @default(autoincrement())
  user_id        Int
  achievement_id Int
  progress       Int      @default(0)
  completed_at   DateTime?
  claimed_at     DateTime?
  
  user        User        @relation(fields: [user_id], references: [id])
  achievement Achievement @relation(fields: [achievement_id], references: [id])
  
  @@unique([user_id, achievement_id])
}

model UserInventory {
  id         Int      @id @default(autoincrement())
  user_id    Int
  item_type  InventoryType
  reference_id   Int      // References Pack.id OR Item.id
  quantity   Int      @default(1)
  expires_at DateTime?
  acquired_at DateTime @default(now())
  
  user User @relation(fields: [user_id], references: [id])
}

enum InventoryType {
  PACK
  ITEM
}

model ShopItem {
  id         Int      @id @default(autoincrement())
  item_type  ShopItemType // "PACK" or "ITEM"
  item_id    Int          // References Pack.id or Item.id
  price      Float
  is_available Boolean @default(true)
  
  @@unique([item_type, item_id])
}

enum ShopItemType {
  PACK
  ITEM
}