generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int        @id @default(autoincrement())
  clerkId          String     @unique 
  full_name        String?
  username         String?    @unique 
  email            String     @unique
  user_status      UserStatus @default(STANDARD)
  created_at       DateTime   @default(now())
  last_login       DateTime   @default(now())
  total_pulls      Int        @default(0)
  unique_cards     Int        @default(0)
  wins             Int        @default(0)
  losses           Int        @default(0)
  trades_completed Int        @default(0)
  purchases_made   Int        @default(0)
  currency         Float      @default(0)
  
  userCards UserCards[]
  userAchievements UserAchievement[]
  userInventory    UserInventory[] 
}

enum UserStatus {
  STANDARD
  SPECIAL
  CREATOR  // Optional: special role for you as the game creator
}

model UserCards {
  id               Int      @id @default(autoincrement())
  user_id          Int
  card_template_id Int
  quality          String
  enhancement      String
  acquired_at      DateTime @default(now())
  is_favourited    Boolean  @default(false)
  kills            Int      @default(0)
  deaths           Int      @default(0)
  sold_amount      Int?     @default(0)
  
  user         User          @relation(fields: [user_id], references: [id])
  cardTemplate CardTemplates @relation(fields: [card_template_id], references: [id])
}

model CardTemplates {
  id        Int     @id @default(autoincrement())
  name      String?
  series    String?
  type      String?
  base_hp   Int
  base_def  Int
  base_atk  Int
  base_price Float
  rarity    String?
  image_url String?
  
  userCards UserCards[]
}

model Pack {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Float
  image_url   String?
  cards_count Int     @default(5)
  is_available Boolean @default(true)
  created_at  DateTime @default(now())
}

model Item {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  item_type   ItemType
  price       Float
  image_url   String?
  effect_value String?
  duration    Int?
  is_available Boolean @default(true)
  created_at  DateTime @default(now())
}

enum ItemType {
  BADGE
  BOOSTER
  CONSUMABLE
  COSMETIC
}

model Achievement {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  image_url   String
  reward_type String   // "pack", "currency", "card", "item" and so on
  reward_value String  // "Ikea_pack", "100", "card_id_42" and so on
  created_at  DateTime @default(now())
  
  userAchievements UserAchievement[]
}

model UserAchievement {
  id             Int      @id @default(autoincrement())
  user_id        Int
  achievement_id Int
  progress       Int      @default(0)
  completed_at   DateTime?
  claimed_at     DateTime?
  
  user        User        @relation(fields: [user_id], references: [id])
  achievement Achievement @relation(fields: [achievement_id], references: [id])
  
  @@unique([user_id, achievement_id])
}

model UserInventory {
  id         Int      @id @default(autoincrement())
  user_id    Int
  item_type  InventoryType
  reference_id   Int      // References Pack.id OR Item.id
  quantity   Int      @default(1)
  expires_at DateTime?
  acquired_at DateTime @default(now())
  
  user User @relation(fields: [user_id], references: [id])
}

enum InventoryType {
  PACK
  ITEM
}

model ShopItem {
  id         Int      @id @default(autoincrement())
  item_type  ShopItemType // "PACK" or "ITEM"
  item_id    Int          // References Pack.id or Item.id
  price      Float
  is_available Boolean @default(true)
  
  @@unique([item_type, item_id])
}

enum ShopItemType {
  PACK
  ITEM
}