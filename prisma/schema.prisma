generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int        @id @default(autoincrement())
  clerkId     String     @unique 
  full_name   String?
  username    String?    @unique 
  email       String     @unique
  user_status UserStatus @default(STANDARD)
  created_at  DateTime   @default(now())
  last_login  DateTime   @default(now())
  currency    Float      @default(0)
  
  // Relations
  userCards        UserCards[]
  userAchievements UserAchievement[]
  userInventory    UserInventory[]
  userStats        UserStats?
  userCardCompletions UserCardCompletion[]
}

enum UserStatus {
  STANDARD
  SPECIAL
  CREATOR
}

model UserStats {
  id                  Int      @id @default(autoincrement())
  user_id             Int      @unique
  total_pulls         Int      @default(0)
  unique_cards        Int      @default(0)
  wins                Int      @default(0)
  losses              Int      @default(0)
  trades_completed    Int      @default(0)
  purchases_made      Int      @default(0)
  login_streak        Int      @default(0)
  last_login_date     DateTime?
  total_play_minutes  Int      @default(0)
  total_cards_sold    Int      @default(0)
  consecutive_wins    Int      @default(0)
  highest_win_streak  Int      @default(0)
  consecutive_losses  Int      @default(0)
  highest_lose_streak Int      @default(0)
  battle_rating       Float    @default(1000)
  updated_at          DateTime @updatedAt

  total_currency_spent      Float @default(0)
  total_currency_gained     Float @default(0)
  total_cards_enhanced      Int   @default(0)
  highest_battle_rating     Float @default(1000)
  tournament_wins           Int   @default(0)
  lucky_pulls               Int   @default(0)
  one_shots                 Int   @default(0)
  trade_flips               Int   @default(0)
  login_count               Int   @default(0)
  
  user User @relation(fields: [user_id], references: [id])
}

model UserCards {
  id               Int         @id @default(autoincrement())
  user_id          Int
  card_template_id Int
  quality          Quality     @default(REGULAR)
  enhancement      Enhancement @default(BASIC)
  acquired_at      DateTime    @default(now())
  is_favourited    Boolean     @default(false)
  kills            Int         @default(0)
  deaths           Int         @default(0)
  sold_amount      Int?        @default(0)
  
  user         User          @relation(fields: [user_id], references: [id])
  cardTemplate CardTemplates @relation(fields: [card_template_id], references: [id])
}

model UserCardCompletion {
  id               Int      @id @default(autoincrement())
  user_id          Int
  card_template_id Int
  completed_at     DateTime @default(now())
  
  user         User          @relation(fields: [user_id], references: [id])
  cardTemplate CardTemplates @relation(fields: [card_template_id], references: [id])
  
  @@unique([user_id, card_template_id])
}

enum Quality {
  TARNISHED
  POOR
  REGULAR
  GOOD
  CRISP
}

enum Enhancement {
  BASIC
  FOILED
  SHINY
  SIGNED
}

model CardTemplates {
  id        Int     @id @default(autoincrement())
  name      String?
  description String?
  series    Series?
  type      Type?
  base_hp   Int?
  base_def  Int?
  base_atk  Int?
  base_price Float
  rarity    Rarity
  image_url String?
  
  userCards UserCards[]
  userCardCompletions UserCardCompletion[]
}

enum Series {
  CARD_GAMES
}

enum Type {
  DIGITAL
  VIDEO_GAME
  GAME
}

enum Rarity {
  COMMON
  UNCOMMON
  SPARSE
  RARE
  UBER_RARE
  MYTHICAL
  LEGENDARY
  SPECIAL
}

model Pack {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Float
  image_url   String?
  cards_count Int     @default(5)
  
  common_rate       Float   @default(53.7)
  uncommon_rate     Float   @default(22.6)
  sparse_rate       Float   @default(12.4)
  rare_rate         Float   @default(7.4)
  uber_rare_rate    Float   @default(2.3)
  mythical_rate     Float   @default(1.2)
  legendary_rate    Float   @default(0.4)
  special_rate      Float   @default(0)

  tarnished_rate    Float @default(20)
  poor_rate         Float @default(30)
  regular_rate      Float @default(30)
  good_rate         Float @default(15)
  crisp_rate        Float @default(5)

  basic_rate        Float @default(85)
  foiled_rate       Float @default(10)
  shiny_rate        Float @default(4)
  signed_rate       Float @default(1)
  
  included_series     Json?
  excluded_series     Json?
  included_types      Json?
  guaranteed_card_ids Json?
  guaranteed_count    Int     @default(0)
  
  is_available        Boolean @default(true)
  available_from      DateTime?
  available_until     DateTime?
  created_at          DateTime @default(now())
  
  is_special          Boolean @default(false)
  boost_multiplier    Float?  @default(1.0)
}

model Item {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  item_type    ItemType
  price        Float
  image_url    String?
  is_available Boolean @default(true)
  created_at   DateTime @default(now())
  can_sell     Boolean  @default(true)
}

enum ItemType {
  COSMETIC
}

model Achievement {
  id            Int     @id @default(autoincrement())
  name          String
  description   String
  image_url     String
  condition     Condition
  comparator    Comparator
  data_type     DataType
  value_int     Int?
  value_float   Float?
  value_string  String?
  value_bool    Boolean?
  value_date    DateTime?
  reward_type   Reward
  reward_value  String
  created_at    DateTime @default(now())
  
  userAchievements UserAchievement[]
}

enum Comparator {
  MORE_THAN
  LESS_THAN
  EQUAL
  MORE_OR_EQUAL
  LESS_OR_EQUAL
}

enum Condition {
  CURRENCY
  CURRENCY_SPENT
  CURRENCY_GAINED
  LOSSES
  WINS
  CARDS_COLLECTED
  PACKS_OPENED
  CARD_STRENGTH
  CARD_DEFENCE
  CARD_HEALTH
  CARD_RARITY
  CARD_NAME_LENGTH
  CARD_NAME_WORDS
  STATUS
  ACCOUNT_AGE
  LOGIN_STREAK
  TOTAL_LOGINS
  TRADES_COMPLETED
  ENHANCED_CARDS
  CONSECUTIVE_WINS
  CARDS_SOLD
  PURCHASES_MADE
  UNIQUE_CARD_SERIES
  CARD_SET_COMPLETION
  BATTLE_RATING
  TOURNAMENT_WINS
  ACHIEVEMENT_COUNT
  INVENTORY_ITEMS
  RARITY_COLLECTION
  BATTLE_PARTICIPATION
  KILLS_IN_BATTLES
  PLAY_TIME
  SERIES_COMPLETED
  LUCKY_PULL
  ONE_SHOT
  TRADE_FLIP
}

enum DataType {
  STRING
  INT
  FLOAT
  BOOLEAN
  DATE
}

enum Reward {
  NONE
  CARD
  PACK
  COSMETIC
  CURRENCY
  STATUS
}

model UserAchievement {
  id             Int      @id @default(autoincrement())
  user_id        Int
  achievement_id Int
  progress       Int      @default(0)
  completed_at   DateTime?
  claimed_at     DateTime?
  
  user        User        @relation(fields: [user_id], references: [id])
  achievement Achievement @relation(fields: [achievement_id], references: [id])
  
  @@unique([user_id, achievement_id])
}

model UserInventory {
  id           Int      @id @default(autoincrement())
  user_id      Int
  item_type    InventoryType
  reference_id Int
  quantity     Int      @default(1)
  expires_at   DateTime?
  acquired_at  DateTime @default(now())
  
  user User @relation(fields: [user_id], references: [id])
}

enum InventoryType {
  PACK
  ITEM
}

model ShopItem {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  item_type    ShopItemType
  reference_id Int      // ID of the pack or item
  price        Float
  image_url    String?
  rarity       Rarity?  // For card slots
  is_available Boolean  @default(true)
  created_at   DateTime @default(now())
}

enum ShopItemType {
  ONE_TIME_PACK
  MULTI_BUY_PACK
  CARD_SLOT
  MYTHICAL_CARD
  ITEM_SLOT
}